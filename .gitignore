node_modules/
test-results/
playwright-report/
# The impact map tools/affected.mjs picks specs from: one full run's coverage
# on this checkout (`npm run test:full` rewrites it). A cache, not a source.
.impact/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
report2027/web/__export-*.html
/tmp/

# Per-machine editor registry: which reports this computer serves, and where
# their files live. Paths here are local to one person, so it is generated
# rather than tracked — see docs/primer/projects.example.json.
docs/primer/projects.json

# Per-machine vendoring targets (see docsync/vendor.py consumers()).
vendor.local.yml

# --- generated under docs/ ---------------------------------------------------
# docs/ is this repo's LOCAL serving directory, not a published site: there is
# no Pages site here (the Budget Primer publishes from its own repo), so these
# were tracked build artifacts nothing consumed. Every engine change rewrote
# four staged copies of the editor plus four manifests — ~38 files a commit, in
# generated content no human can resolve a merge conflict in.
#
# `make -C report2027 live` rebuilds every project on startup, so a fresh clone
# regenerates all of this on first run; `make -C report2027 pub` does it
# without the server.
docs/*/edit.html
docs/*/engine/
docs/primer/index.html
docs/primer/primer.css
docs/primer/primer.js
# Staged by docsync.stage for EVERY project now (the editor's iframe reads a
# box's "assets/…" src against the editor's page), not just the primer's build.
docs/*/assets/

# Built by tools/make_installer_zip.sh — the send-to-a-colleague zip. An
# artifact you rebuild, never a source you track.
/dist/

# The GitHub token File > Connect GitHub stores for the server's own pushes.
# A person, not a project — and never, ever committed.
.primer-github-token

# Written by tools/selfupdate.py before it moves the checkout: the way back
# from a bad update. Per-machine state, never committed.
.primer-previous-version

# The agent-change journal (who edited a report and what was rewound).
# Local state, like a draft — never part of a report.
.docsync-agent-log.json

# Plain-text versions of the rendered reports (`python3 -m docsync.text`).
# Regenerated from committed HTML in one command, and the projects here are
# fixtures — a consumer repo that wants its text version tracked commits it
# there instead.
*-text.md
