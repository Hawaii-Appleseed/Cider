    {
      "id": "t34",
      "page": 1,
      "x": 0.7,
      "y": 1.82,
      "w": 6.2,
      "z": 11,
      "md": "Local families can no longer afford to remain in Hawaiʻi , while the ultra-wealthy continue to build on their fortunes. These three tax policies would ask the wealthiest among us to pay more, without affecting working families.",
      "style": {
        "font": "Poppins",
