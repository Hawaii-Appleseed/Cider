{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "primer-collab",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // One Durable Object per project document. `new_sqlite_classes` (rather than
  // `new_classes`) is required: SQLite-backed Durable Objects are the only kind
  // available on the Workers free plan.
  "durable_objects": {
    "bindings": [{ "name": "PrimerRoom", "class_name": "PrimerRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrimerRoom"] }],

  "observability": { "enabled": true },

  // The hub's document store (step 04) — the same bucket the hub's
  // /api/docs writes. Read here by the export (src/export.js), which is the
  // only writer to git: one commit per Publish, and the sweep below.
  "r2_buckets": [{ "binding": "PRIMER_DOCS", "bucket_name": "primer-docs" }],
  // 04:00 Hawaiʻi. Every room whose saved version the branch lacks gets one commit.
  "triggers": { "crons": ["0 14 * * *"] },

  "vars": {
    // Browsers allowed to open a collaborative session through the ticket
    // door: local dev. (The github.io origin is a leftover of the hosted
    // editor, removed 2026-10-30; the hub reaches the room through its own
    // door, not this list.)
    "ALLOWED_ORIGINS": "https://hawaii-appleseed.github.io,http://localhost:8777,http://localhost:8010,http://127.0.0.1:8777,http://127.0.0.1:8010",
    // Repositories whose collaborators may open a room here. A room names its
    // repo, so without this anyone with push access to ANY repo could mint a
    // ticket for a room named after someone else's.
    //
    // Only the Hawaii-Appleseed spellings: every staged manifest says so, and
    // a room is named from the manifest. The pre-org `dtomkatsu/…` and the
    // pre-rename `primer-editor` slugs were dropped once nothing used them.
    "ALLOWED_REPOS": "Hawaii-Appleseed/Cider,Hawaii-Appleseed/BudgetPrimerFinal"
  },

  // STAGING: a second relay that shares nothing with the one above, so a
  // change to the room, the editor or the hub can be opened, typed into and
  // broken before anyone's real document meets it. `npm run deploy:staging`.
  // The hub's Preview environment binds THIS Worker's rooms and bucket (see
  // the hub's `node dev/cf.mjs staging`), so every branch preview of the hub
  // — `staging.staff-updates-internal.pages.dev` above all — is a sandbox.
  //
  // What it leaves out is the point: no cron and no GitHub App secrets, so
  // nothing typed into staging can ever be committed to a real repository
  // (the export answers 501 without EXPORT_KEY's partner and skips without a
  // credential). Its own COLLAB_SECRET and EXPORT_KEY, never production's.
  // Bindings and vars are not inherited by an environment, hence the repeats.
  "env": {
    "staging": {
      "name": "primer-collab-staging",
      "durable_objects": {
        "bindings": [{ "name": "PrimerRoom", "class_name": "PrimerRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrimerRoom"] }],
      "r2_buckets": [{ "binding": "PRIMER_DOCS", "bucket_name": "primer-docs-staging" }],
      "triggers": { "crons": [] },
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:8777,http://localhost:8010,http://127.0.0.1:8777,http://127.0.0.1:8010",
        "ALLOWED_REPOS": "Hawaii-Appleseed/Cider,Hawaii-Appleseed/BudgetPrimerFinal"
      }
    }
  }

  // Secrets, not vars (npx wrangler secret put <NAME>):
  //   COLLAB_SECRET        signs short-lived connection tickets; any high-entropy
  //                        string. `wrangler dev` falls back to a fixed value.
  //   EXPORT_KEY           shared with the hub (its EXPORT_KEY env var): what a
  //                        caller must present to trigger an export. Without it
  //                        /export/* answers 501.
  //   GITHUB_APP_ID        the id of the "Cider Publisher" GitHub App (5402715),
  //   GITHUB_APP_PRIVATE_KEY  and a private key for it (the .pem as downloaded).
  //                        The Worker mints a one-hour token for the room's
  //                        repository from these (src/githubApp.js): Contents:
  //                        read and write, nothing to renew. The only GitHub
  //                        credential anywhere on the hub path.
  //   GITHUB_EXPORT_TOKEN  optional fallback: a fine-grained PAT, Contents: read
  //                        and write, on the repositories in ALLOWED_REPOS. The
  //                        app wins when both are set.
  // GITHUB_API (a var) overrides https://api.github.com for a test double.
}
