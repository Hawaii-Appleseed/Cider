{
  "permissions": {
    "ask": [
      "Edit(docsync/**)",
      "Write(docsync/**)",
      "Edit(report2027/tools/**)",
      "Write(report2027/tools/**)",
      "Edit(tools/**)",
      "Write(tools/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/setup.sh\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/editability-guard.py\" --hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
